# OpenAI
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
MANAGER_MODEL=gpt-4o

# Azure OpenAI (set the endpoint to use managed identity instead of OPENAI_API_KEY)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_MANAGER_MODEL=gpt-4o

# Azure AI Foundry OpenAI-compatible endpoint (API key authentication)
FOUNDRY_OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-6-luna
FOUNDRY_MANAGER_MODEL=gpt-6-luna

# Persistent checkpoint directory (mount durable storage when deploying to Azure)
CHECKPOINT_DIR=./checkpoints

# OpenTelemetry (set to a real endpoint to export traces)
OTEL_SERVICE_NAME=crisil-claim-verifier
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Security: never enable sensitive data in production (financial PII)
ENABLE_SENSITIVE_DATA=false